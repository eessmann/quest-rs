+    fn feasible(point: &Vector, radius: &BigInt) -> bool {
+        let [a, b, c, d] = point;
+        let n = radius * radius - a * a - b * b - c * c - d * d;
+        let m = a * (b - d) + c * (b + d);
+        !n.is_negative() && &n * &n >= &m * &m * 2
